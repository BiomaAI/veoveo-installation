#!/usr/bin/env python3
"""Configure local OpenShell OIDC clients; keep management secrets outside workloads."""
import json
import os
from pathlib import Path
import runpy
import secrets

ROOT = Path(__file__).resolve().parent.parent


def main():
    os.umask(0o077)
    request = runpy.run_path(str(ROOT / "identity/provision"))["request"]
    identity = json.loads((ROOT / "state/identity/credentials.json").read_text())
    token = request("/realms/master/protocol/openid-connect/token", "POST", {
        "grant_type": "password", "client_id": "admin-cli", "username": identity["adminUsername"],
        "password": identity["adminPassword"]}, form=True)["access_token"]
    directory = ROOT / "state/openshell"
    directory.mkdir(mode=0o700, exist_ok=True)
    secret_path = directory / "controller.secret"
    if not secret_path.exists():
        secret_path.write_text(secrets.token_urlsafe(36))
    for role in ["openshell-admin", "openshell-user"]:
        roles = request("/admin/realms/veoveo/roles", token=token)
        if not any(value["name"] == role for value in roles):
            request("/admin/realms/veoveo/roles", "POST", {"name": role}, token)
    admin_role = request("/admin/realms/veoveo/roles/openshell-admin", token=token)
    for client_id, public in [("openshell-cli", True), ("veoveo-controller", False), ("veoveo-outsider", False)]:
        clients = request("/admin/realms/veoveo/clients?clientId=" + client_id, token=token)
        client = {
            "clientId": client_id, "protocol": "openid-connect", "enabled": True,
            "publicClient": public, "standardFlowEnabled": public,
            "serviceAccountsEnabled": not public, "directAccessGrantsEnabled": False,
            "implicitFlowEnabled": False, "defaultClientScopes": ["basic", "profile", "roles"],
            "optionalClientScopes": ["offline_access"] if public else [],
            # Keycloak applies RFC 8252 dynamic-port matching to HTTP loopback
            # redirects. Keep the host and callback path exact, without '*'.
            "redirectUris": ["http://127.0.0.1/callback", "http://127.0.0.1:80/callback"] if public else [],
            "attributes": {"access.token.lifespan": "120", "pkce.code.challenge.method": "S256"},
            "protocolMappers": [
                {"name": "openshell-audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper",
                 "config": {"included.custom.audience": "openshell", "access.token.claim": "true"}},
                {"name": "openshell-scopes", "protocol": "openid-connect", "protocolMapper": "oidc-hardcoded-claim-mapper",
                 "config": {"claim.name": "openshell_scopes", "claim.value": "openshell:all",
                            "jsonType.label": "String", "access.token.claim": "true"}}],
        }
        credential_path = directory / ("outsider.secret" if client_id == "veoveo-outsider" else "controller.secret")
        if not public:
            if not credential_path.exists():
                credential_path.write_text(secrets.token_urlsafe(36))
            client["secret"] = credential_path.read_text().strip()
        if clients:
            request("/admin/realms/veoveo/clients/" + clients[0]["id"], "PUT", client, token)
        else:
            request("/admin/realms/veoveo/clients", "POST", client, token)
        client_key = request("/admin/realms/veoveo/clients?clientId=" + client_id, token=token)[0]["id"]
        scopes = request("/admin/realms/veoveo/client-scopes", token=token)
        for scope_name in ["basic", "profile", "roles"]:
            scope = next(scope for scope in scopes if scope["name"] == scope_name)
            request("/admin/realms/veoveo/clients/" + client_key + "/default-client-scopes/" + scope["id"], "PUT", None, token)
        if public:
            # Updating ClientRepresentation does not update existing scope links.
            offline = next(scope for scope in scopes if scope["name"] == "offline_access")
            request("/admin/realms/veoveo/clients/" + client_key + "/optional-client-scopes/" + offline["id"], "PUT", None, token)
        subject = identity["userId"] if public else request(
            "/admin/realms/veoveo/clients/" + client_key + "/service-account-user", token=token)["id"]
        role = request("/admin/realms/veoveo/roles/openshell-user", token=token) if client_id == "veoveo-outsider" else admin_role
        request("/admin/realms/veoveo/users/" + subject + "/role-mappings/realm", "POST", [role], token)
    config = {"issuer": "https://auth.localhost:8443/realms/veoveo", "clientId": "veoveo-controller",
              "clientSecretFile": str(secret_path), "audience": "openshell",
              "gateway": "https://localhost:17670", "gatewayCaFile": "/opt/homebrew/var/openshell/tls/ca.crt"}
    (directory / "controller.json").write_text(json.dumps(config, indent=2) + "\n")
    config["clientId"] = "veoveo-outsider"
    config["clientSecretFile"] = str(directory / "outsider.secret")
    (directory / "outsider.json").write_text(json.dumps(config, indent=2) + "\n")
    print("Configured local OpenShell OIDC clients; controller and nonmember acceptance credentials remain private")


if __name__ == "__main__":
    try:
        main()
    except Exception as error:
        raise SystemExit(f"OpenShell OIDC provisioning failed ({type(error).__name__}); credentials were not printed") from None
