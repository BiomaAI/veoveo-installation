#!/usr/bin/env python3
"""Provision the optional, persistent local Keycloak installation. Never print secrets."""
import argparse
import getpass
import json
import os
from pathlib import Path
import secrets
import shutil
import ssl
import subprocess
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request
import uuid

ROOT = Path(__file__).resolve().parent.parent
STATE = ROOT / 'state/identity'
ISSUER = 'https://auth.localhost:8443/realms/veoveo'


def write(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_suffix(path.suffix + '.next')
    temporary.write_text(value)
    temporary.chmod(0o600)
    temporary.replace(path)


def run(*args):
    return subprocess.run(args, cwd=ROOT, check=True, capture_output=True)


def certificate(renew=False):
    directory = ROOT / 'tls/identity'
    directory.mkdir(parents=True, exist_ok=True)
    key, cert = directory / 'identity.key', directory / 'identity.crt'
    existing = key.exists() and cert.exists()
    if key.exists() != cert.exists():
        raise ValueError('incomplete identity TLS material')
    if existing and not renew:
        return
    if renew and not existing:
        raise ValueError('renewal requires existing identity leaf material')
    ca, ca_key = ROOT / 'tls/ca/ca.crt', ROOT / 'tls/private/ca.key'
    if not ca.is_file() or not ca_key.is_file():
        raise ValueError('preserve and restore the existing installation CA before issuing a leaf')
    backup = None
    with tempfile.TemporaryDirectory(dir=ROOT / 'tls/private') as temporary:
        stage = Path(temporary)
        (stage / 'extensions').write_text(
            'subjectAltName=DNS:auth.localhost,DNS:host.openshell.internal,IP:127.0.0.1\n'
            'basicConstraints=critical,CA:FALSE\nkeyUsage=critical,digitalSignature\n'
            'extendedKeyUsage=serverAuth\nsubjectKeyIdentifier=hash\nauthorityKeyIdentifier=keyid,issuer\n')
        if existing:
            # Renew under the same leaf key. An atomic certificate replacement
            # cannot create a transient mismatch with the active private key.
            public_key = run('openssl', 'pkey', '-in', str(key), '-pubout').stdout
            if public_key != run('openssl', 'x509', '-in', str(cert), '-pubkey', '-noout').stdout:
                raise ValueError('existing identity certificate and key differ')
            run('openssl', 'req', '-new', '-key', str(key), '-subj', '/CN=auth.localhost',
                '-out', str(stage / 'request'))
        else:
            run('openssl', 'req', '-newkey', 'ec', '-pkeyopt', 'ec_paramgen_curve:P-256',
                '-nodes', '-subj', '/CN=auth.localhost', '-keyout', str(stage / 'key'),
                '-out', str(stage / 'request'))
        run('openssl', 'x509', '-req', '-in', str(stage / 'request'),
            '-CA', str(ca), '-CAkey', str(ca_key),
            # A fresh serial avoids modifying the CA's existing serial file.
            '-set_serial', '0x' + secrets.token_hex(19), '-days', '365',
            '-extfile', str(stage / 'extensions'), '-out', str(stage / 'certificate'))
        run('openssl', 'verify', '-CAfile', str(ca), str(stage / 'certificate'))
        for hostname in ['auth.localhost', 'host.openshell.internal']:
            run('openssl', 'x509', '-in', str(stage / 'certificate'), '-noout', '-checkhost', hostname)
        run('openssl', 'x509', '-in', str(stage / 'certificate'), '-noout', '-checkip', '127.0.0.1')
        if existing:
            STATE.mkdir(parents=True, exist_ok=True, mode=0o700)
            STATE.chmod(0o700)
            backups = STATE / 'tls-backups'
            backups.mkdir(exist_ok=True, mode=0o700)
            backups.chmod(0o700)
            backup = backups / (time.strftime('%Y%m%dT%H%M%SZ', time.gmtime()) + '-' + secrets.token_hex(4))
            backup.mkdir(mode=0o700)
            for source in [key, cert]:
                destination = backup / source.name
                shutil.copyfile(source, destination)
                destination.chmod(0o600)
        else:
            (stage / 'key').chmod(0o600)
            (stage / 'key').replace(key)
        (stage / 'certificate').chmod(0o644)
        (stage / 'certificate').replace(cert)
    key.chmod(0o600)
    return backup


def request(path, method='GET', data=None, token=None, form=False):
    # The explicit loopback address works on Linux too, without changing host DNS.
    headers = {'Host': 'auth.localhost:8443'}
    if token:
        headers['Authorization'] = 'Bearer ' + token
    if data is not None:
        headers['Content-Type'] = 'application/x-www-form-urlencoded' if form else 'application/json'
        data = (urllib.parse.urlencode(data) if form else json.dumps(data)).encode()
    req = urllib.request.Request('https://127.0.0.1:8443' + path, data, headers, method=method)
    context = ssl.create_default_context(cafile=ROOT / 'tls/ca/ca.crt')
    with urllib.request.urlopen(req, context=context, timeout=10) as response:
        body = response.read()
        return json.loads(body) if body else None


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--renew-identity-certificate', action='store_true',
                        help='renew only the existing identity leaf under its current CA and key; back up the old leaf privately')
    options = parser.parse_args()
    os.umask(0o077)
    if options.renew_identity_certificate:
        backup = certificate(renew=True)
        print('Renewed identity leaf under the existing CA/key; backup: ' + str(backup.relative_to(ROOT)))
        print('No services or identity records changed. Reload only the identity HTTPS listener to activate it.')
        return
    STATE.mkdir(parents=True, exist_ok=True)
    STATE.chmod(0o700)
    credentials = STATE / 'credentials.json'
    if credentials.exists():
        config = json.loads(credentials.read_text())
    else:
        present = subprocess.run(['docker', 'volume', 'inspect', 'vv-local_vv-keycloak-db'],
                                 capture_output=True).returncode == 0
        if present:
            raise ValueError('recover the identity credentials for the existing database; do not replace them')
        username = getpass.getuser()
        config = {'username': username, 'userId': str(uuid.uuid4()),
                  'adminUsername': username + '-admin', 'adminId': str(uuid.uuid4()),
                  **{key: secrets.token_urlsafe(36) for key in
                     ['password', 'adminPassword', 'databasePassword', 'postgresPassword',
                      'bootstrapSecret']}}
        write(credentials, json.dumps(config, indent=2) + '\n')
    write(STATE / 'database.env', 'POSTGRES_PASSWORD=' + config['postgresPassword'] + '\n'
          + 'KEYCLOAK_DATABASE_PASSWORD=' + config['databasePassword'] + '\n')
    kc_env = 'KC_DB_PASSWORD=' + config['databasePassword'] + '\n'
    if 'bootstrapSecret' in config:
        kc_env += ('KC_BOOTSTRAP_ADMIN_CLIENT_ID=veoveo-bootstrap\n'
                   'KC_BOOTSTRAP_ADMIN_CLIENT_SECRET=' + config['bootstrapSecret'] + '\n')
    write(STATE / 'keycloak.env', kc_env)
    certificate()
    env = ROOT / '.env'
    lines = env.read_text().splitlines()
    previous = next((line.split('=', 1)[1] for line in lines if line.startswith('COMPOSE_PROFILES=')), '')
    profiles = [p for p in previous.split(',') if p]
    if 'keycloak' not in profiles:
        profiles.append('keycloak')
    lines = [line for line in lines if not line.startswith('COMPOSE_PROFILES=')]
    write(env, '\n'.join(lines) + '\nCOMPOSE_PROFILES=' + ','.join(profiles) + '\n')
    run('docker', 'volume', 'create', 'vv-local_vv-keycloak-db')
    run('docker', 'compose', 'config', '--quiet')
    print('Starting persistent Keycloak, PostgreSQL and the TLS edge.', flush=True)
    run('docker', 'compose', 'up', '-d', 'vv-keycloak-db', 'vv-keycloak', 'vv-identity-edge')
    for _ in range(90):
        try:
            request('/realms/master/.well-known/openid-configuration')
            break
        except (OSError, urllib.error.URLError):
            time.sleep(2)
    else:
        raise ValueError('Keycloak did not become ready')
    if 'bootstrapSecret' in config:
        token = request('/realms/master/protocol/openid-connect/token', 'POST', {
            'grant_type': 'client_credentials', 'client_id': 'veoveo-bootstrap',
            'client_secret': config['bootstrapSecret']}, form=True)['access_token']
        # A permanent administrator replaces the temporary bootstrap service account.
        users = request('/admin/realms/master/users?username=' + urllib.parse.quote(config['adminUsername']) + '&exact=true', token=token)
        if not users:
            request('/admin/realms/master/users', 'POST', {
                'id': config['adminId'], 'username': config['adminUsername'], 'enabled': True,
                'credentials': [{'type': 'password', 'value': config['adminPassword'], 'temporary': True}]}, token)
        else:
            config['adminId'] = users[0]['id']
        role = request('/admin/realms/master/roles/admin', token=token)
        request('/admin/realms/master/users/' + config['adminId'] + '/role-mappings/realm', 'POST', [role], token)
        realms = request('/admin/realms', token=token)
        if not any(r['realm'] == 'veoveo' for r in realms):
            request('/admin/realms', 'POST', {
                'realm': 'veoveo', 'enabled': True, 'displayName': 'Veoveo Local',
                'sslRequired': 'all', 'registrationAllowed': False, 'bruteForceProtected': True,
                'resetPasswordAllowed': False, 'rememberMe': True,
                'accessTokenLifespan': 300, 'ssoSessionIdleTimeout': 1800,
                'ssoSessionMaxLifespan': 36000,
                # Realm imports do not automatically assign the default roles to
                # imported users. These include the account console's self-service
                # permissions; Veoveo resource membership is granted separately.
                'users': [{'id': config['userId'], 'username': config['username'], 'enabled': True,
                           'realmRoles': ['default-roles-veoveo'],
                           'credentials': [{'type': 'password', 'value': config['password'], 'temporary': False}]}]
            }, token)
        profile = request('/admin/realms/veoveo/users/profile', token=token)
        for attribute in profile['attributes']:
            if attribute['name'] != 'username':
                attribute.pop('required', None)
        request('/admin/realms/veoveo/users/profile', 'PUT', profile, token)
        bootstrap = request('/admin/realms/master/clients?clientId=veoveo-bootstrap', token=token)
        for client in bootstrap:
            request('/admin/realms/master/clients/' + client['id'], 'DELETE', token=token)
        del config['bootstrapSecret']
        write(credentials, json.dumps(config, indent=2) + '\n')
        write(STATE / 'keycloak.env', 'KC_DB_PASSWORD=' + config['databasePassword'] + '\n')
        # Remove the bootstrap credential from Docker's container configuration too.
        run('docker', 'compose', 'up', '-d', '--force-recreate', 'vv-keycloak')
    print('Persistent OIDC issuer: ' + ISSUER)
    print('Initial account details: state/identity/credentials.json (owner-only, ignored).')
    print('The temporary bootstrap administrator has been removed.')


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, KeyError, subprocess.CalledProcessError) as error:
        # HTTP bodies and subprocess output can contain secrets; do not echo them.
        raise SystemExit('Identity provisioning failed (' + type(error).__name__ + '). Inspect service status locally.') from None
