#!/usr/bin/env python3
"""Provision only trusted autonomy volumes; never print secret values."""
import json
import os
from pathlib import Path
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parent.parent
os.chdir(ROOT)
os.umask(0o077)


def run(args, **kwargs):
    return subprocess.run(args, check=True, capture_output=True, **kwargs)


def env_value(name):
    values = []
    for line in (ROOT / ".env").read_text().splitlines():
        key, separator, value = line.partition("=")
        if separator and key.strip() == name:
            value = value.strip()
            if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
                value = value[1:-1]
            values.append(value)
    if not values or not values[-1] or any(c.isspace() for c in values[-1]):
        raise ValueError(f"{name} must be a nonempty single-line credential in .env")
    return values[-1]


def main():
    token = env_value("HF_TOKEN")
    (ROOT / ".env").chmod(0o600)
    config = json.loads(run(["docker", "compose", "--profile", "autonomy", "config", "--format", "json"]).stdout)
    project = config["name"]
    volumes = {}
    for short in ["vv-autonomy-secrets", "vv-autonomy-sds", "vv-review"]:
        name = config["volumes"][short]["name"]
        run(["docker", "volume", "create", "--label", f"com.docker.compose.project={project}",
             "--label", f"com.docker.compose.volume={short}", name])
        volumes[short] = name
    run(["docker", "run", "--rm", "-i", "--network", "none", "--user", "root",
         "--cap-drop", "ALL", "--security-opt", "no-new-privileges",
         "-v", volumes["vv-autonomy-secrets"] + ":/secrets", "--entrypoint", "sh", "vv-lore:local",
         "-ec", "umask 077; chmod 700 /secrets; cat > /secrets/.huggingface.next; mv /secrets/.huggingface.next /secrets/huggingface"],
        input=("Bearer " + token).encode())
    run(["docker", "run", "--rm", "--network", "none", "--user", "root",
         "--cap-drop", "ALL", "--cap-add", "CHOWN", "--security-opt", "no-new-privileges",
         "-v", volumes["vv-review"] + ":/review", "--entrypoint", "chown", "vv-lore:local",
         "1000:1000", "/review"])
    tls = ROOT / "tls" / "autonomy"
    tls.mkdir(exist_ok=True)
    key, cert = tls / "server.key", tls / "server.crt"
    if not (key.exists() and cert.exists()):
        with tempfile.TemporaryDirectory(dir=ROOT / "tls" / "private") as temporary:
            directory = Path(temporary)
            extension = directory / "server.ext"
            extension.write_text("subjectAltName=DNS:lore-proxy.internal,DNS:inference.internal\n"
                                 "basicConstraints=critical,CA:FALSE\nkeyUsage=critical,digitalSignature\n"
                                 "extendedKeyUsage=serverAuth\n")
            run(["openssl", "req", "-newkey", "ec", "-pkeyopt", "ec_paramgen_curve:P-256", "-nodes",
                 "-subj", "/CN=lore-proxy.internal", "-keyout", str(key), "-out", str(directory / "server.csr")])
            run(["openssl", "x509", "-req", "-in", str(directory / "server.csr"),
                 "-CA", "tls/ca/ca.crt", "-CAkey", "tls/private/ca.key", "-CAcreateserial", "-days", "825",
                 "-extfile", str(extension), "-out", str(cert)])
    key.chmod(0o600)
    cert.chmod(0o644)
    print("Provisioned trusted autonomy volumes and TLS. Restart vv-autonomy-edge after key rotation.")


if __name__ == "__main__":
    try:
        main()
    except (subprocess.CalledProcessError, OSError, ValueError) as error:
        # Child output and Compose data may contain credentials; never include them.
        raise SystemExit(f"Autonomy provisioning failed ({type(error).__name__}). Check Docker, .env and the installation CA.") from None
