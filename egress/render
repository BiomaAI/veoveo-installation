#!/bin/sh
# Writes egress/envoy.local.yaml from egress/envoy.yaml with the hosts .env names: the
# public origin's, the media provider API's and its output hosts. Run from the
# repository's directory after changing any of them, then restart vv-egress.
set -eu
value() { sed -n "s/^$1=//p" .env | tail -n 1; }
host() { printf '%s\n' "$1" | sed -n 's#^https://\([^/:]*\).*#\1#p'; }
provider=$(host "$(value MEDIA_PROVIDER_URL)")
hosts=$( { host "$(value VEOVEO_PUBLIC_ORIGIN)"; printf '%s\n' "$provider"; value MEDIA_OUTPUT_HOSTS | tr ',' '\n'; } \
  | sed '/^$/d; s/.*/, "&:443"/' | tr -d '\n')
sed -e "s/@EGRESS_HOSTS@/${hosts}/" -e "s/@MEDIA_PROVIDER_HOST@/${provider:-media-provider.invalid}/g" \
  egress/envoy.yaml > egress/envoy.local.yaml
