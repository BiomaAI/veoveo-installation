#!/bin/sh
# Writes egress/envoy.local.yaml from egress/envoy.yaml with the hosts .env names: the
# public origin's, the media provider API's/output hosts, and OIDC provider hosts. Run from the
# repository's directory after changing any of them, then restart vv-egress.
set -eu
value() { sed -n "s/^$1=//p" .env | tail -n 1; }
host() { printf '%s\n' "$1" | sed -n 's#^https://\([^/:]*\).*#\1#p'; }
provider=$(host "$(value MEDIA_PROVIDER_URL)")
oidc_hosts=$(value OIDC_EGRESS_HOSTS | tr ',' '\n')
if printf '%s\n' "$oidc_hosts" | sed '/^$/d' | LC_ALL=C grep -Eq '[^A-Za-z0-9.-]'; then
  printf '%s\n' 'OIDC_EGRESS_HOSTS must contain comma-separated DNS hostnames only.' >&2
  exit 1
fi
hosts=$( { host "$(value VEOVEO_PUBLIC_ORIGIN)"; printf '%s\n' "$provider" "$oidc_hosts"; value MEDIA_OUTPUT_HOSTS | tr ',' '\n'; } \
  | sed '/^$/d; s/.*/, "&:443"/' | tr -d '\n')
sed -e "s/@EGRESS_HOSTS@/${hosts}/" -e "s/@MEDIA_PROVIDER_HOST@/${provider:-media-provider.invalid}/g" \
  egress/envoy.yaml > egress/envoy.local.yaml
