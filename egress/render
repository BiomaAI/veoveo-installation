#!/usr/bin/env python3
"""Render the bootstrap identity-provider allowlist; never render credentials."""
import json
from pathlib import Path
import re
root = Path(__file__).resolve().parent.parent
values = dict(line.split("=", 1) for line in (root / ".env").read_text().splitlines()
              if "=" in line and not line.lstrip().startswith("#"))
hosts = [host.strip() for host in values.get("OIDC_EGRESS_HOSTS", "").strip("\"' ").split(",") if host.strip()]
if any(not re.fullmatch(r"[A-Za-z0-9.-]+", host) for host in hosts):
    raise SystemExit("OIDC_EGRESS_HOSTS must contain DNS hostnames only")
source = (root / "egress/envoy.yaml").read_text()
quoted = json.dumps([host + ":443" for host in hosts] or ["oidc-disabled.invalid:443"])
source = source.replace("- '@OIDC_EGRESS_HOSTS@'", quoted)
# Replace the YAML domains sequence rather than its scalar when generating JSON-style lists.
source = source.replace("domains:\n              " + quoted, "domains: " + quoted)
(root / "egress/envoy.local.yaml").write_text(source)
print("Rendered bootstrap OIDC egress allowlist")
