#!/usr/bin/env python3
"""Issue a self-signed localhost leaf for explicit Desktop certificate trust."""
import argparse
import os
from pathlib import Path
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parent.parent


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--renew", action="store_true", help="replace the leaf; update client trust afterwards")
    options = parser.parse_args()
    os.umask(0o077)
    directory = ROOT / "tls/desktop"
    directory.mkdir(parents=True, exist_ok=True)
    key, cert = directory / "localhost.key", directory / "localhost.crt"
    if (key.exists() or cert.exists()) and not options.renew:
        if not (key.is_file() and cert.is_file()):
            raise ValueError("incomplete Desktop TLS material")
        print("Desktop TLS material already exists; left unchanged.")
        return
    with tempfile.TemporaryDirectory(dir=directory) as temporary:
        stage = Path(temporary)
        extension = stage / "localhost.ext"
        extension.write_text(
            "subjectAltName=DNS:localhost,IP:127.0.0.1,IP:::1\n"
            "basicConstraints=critical,CA:FALSE\n"
            "keyUsage=critical,digitalSignature\n"
            "extendedKeyUsage=serverAuth\n"
            "subjectKeyIdentifier=hash\n"
            "authorityKeyIdentifier=keyid,issuer\n"
        )
        subprocess.run([
            "openssl", "req", "-newkey", "ec", "-pkeyopt", "ec_paramgen_curve:P-256",
            "-nodes", "-subj", "/CN=localhost", "-keyout", str(stage / "localhost.key"),
            "-out", str(stage / "localhost.csr"),
        ], check=True, capture_output=True)
        subprocess.run([
            "openssl", "x509", "-req", "-in", str(stage / "localhost.csr"),
            "-signkey", str(stage / "localhost.key"), "-days", "365",
            "-extfile", str(extension), "-out", str(stage / "localhost.crt"),
        ], check=True, capture_output=True)
        (stage / "localhost.key").replace(key)
        (stage / "localhost.crt").replace(cert)
    key.chmod(0o600)
    cert.chmod(0o644)
    print("Issued a self-signed localhost TLS leaf (not a CA). No operating-system trust settings changed.")


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        raise SystemExit(f"Desktop TLS provisioning failed ({type(error).__name__}).") from None
