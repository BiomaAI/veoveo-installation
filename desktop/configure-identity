#!/usr/bin/env python3
"""Deploy an existing OIDC configuration and private credentials, independent of provider."""
import io
import json
import os
from pathlib import Path
import subprocess
import tarfile

ROOT = Path(__file__).resolve().parent.parent
STATE = ROOT / 'state/desktop/identity'
IMAGE = 'debian:trixie-slim@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f'


def run(args, **kwargs):
    return subprocess.run(args, cwd=ROOT, capture_output=True, check=True, **kwargs)


def main():
    os.umask(0o077)
    STATE.mkdir(parents=True, exist_ok=True)
    config_path = STATE / 'config.json'
    secret_path = STATE / 'oidc.secret'
    config = json.loads(config_path.read_text())
    # Standard mounted paths; no provider management API or bootstrap credential.
    if config['clientSecretFile'] != '/etc/veoveo/oidc.secret' or config['signingKeyFile'] != '/etc/veoveo/signing.key':
        raise ValueError('Configuration must use the documented credential mount paths')
    if not secret_path.read_text().strip():
        raise ValueError('An OIDC client credential is required')
    for field in ['oidcIssuer', 'clientId', 'oidcScopes', 'oidcClientAuthMethod', 'oidcIdTokenAlgorithms']:
        if not config[field]:
            raise ValueError('Incomplete OIDC configuration')
    key = STATE / 'signing.key'
    if not key.exists():
        run(['openssl', 'genpkey', '-algorithm', 'RSA', '-pkeyopt', 'rsa_keygen_bits:3072', '-out', str(key)])
    for path in [key, secret_path, config_path]:
        path.chmod(0o600)
    for name in ['vv-local_vv-lore-identity-secrets', 'vv-local_vv-lore-identity']:
        run(['docker', 'volume', 'create', name])
    archive = io.BytesIO()
    with tarfile.open(fileobj=archive, mode='w') as tar:
        for path in [key, secret_path, config_path]:
            info = tarfile.TarInfo(path.name)
            data = path.read_bytes()
            info.size = len(data)
            info.uid = info.gid = 10001
            info.mode = 0o400
            tar.addfile(info, io.BytesIO(data))
    run(['docker', 'run', '--rm', '-i', '--network', 'none', '--cap-drop', 'ALL', '--cap-add', 'CHOWN',
         '--cap-add', 'DAC_OVERRIDE', '--security-opt', 'no-new-privileges:true',
         '-v', 'vv-local_vv-lore-identity-secrets:/secrets', IMAGE, 'tar', '-xf', '-', '-C', '/secrets'], input=archive.getvalue())
    print('Deployed OIDC configuration and private credentials; provider registration and grants unchanged.')


if __name__ == '__main__':
    try:
        main()
    except Exception as error:
        raise SystemExit(f'Desktop identity configuration failed ({type(error).__name__}); credentials were not printed.') from None
