{
  "computers": {
    "gateway": {
      "endpoint": "https://openshell.openshell.svc.cluster.local:8080",
      "certificateAuthority": "/run/openshell-supervisor-ca/material/ca.crt",
      "bearerEnvironment": "HUB_NATIVE_CONTROL_REFERENCE"
    },
    "template": {
      "workspace": "installation",
      "name": "computer-v1"
    },
    "policyFile": "@claim:computer-policy@",
    "command": [
      "/bin/sh",
      "-ec",
      "umask 077; exec /usr/local/bin/opencode serve --trusted-local-proxy --hostname 127.0.0.1 --port 4096 --base-path \"${PUBLIC_BASE_PATH:?trusted PUBLIC_BASE_PATH is required}\""
    ],
    "oauthClient": "computer-browser",
    "profile": "computer",
    "workContext": "reference-work",
    "port": 4096,
    "forwardingConnectionLimit": 512,
    "collectAfterSeconds": 7200,
    "hubProvider": {
      "profile": "vv-computer-hub",
      "credentialKey": "COMPUTER_HUB_REFERENCE"
    },
    "modelProvider": {
      "profile": "vv-computer-model",
      "credentialKey": "DEEPINFRA_API_KEY",
      "secret": "computer-model-api-key"
    },
    "loreProvider": {
      "profile": "vv-lore",
      "credentialKey": "LORE_ACCESS_TOKEN"
    }
  },
  "secrets": [
    {
      "id": "computer-model-api-key",
      "source": "env",
      "purpose": "provider_api_key",
      "locator": "VEOVEO_COMPUTER_MODEL_API_KEY",
      "owner": {
        "kind": "hub"
      },
      "metadata": {}
    }
  ],
  "nativeUpstreams": {
    "gateway": "https://openshell.openshell.svc.cluster.local:8080",
    "certificateAuthority": "/run/openshell-supervisor-ca/material/ca.crt",
    "bearerEnvironment": "HUB_NATIVE_CONTROL_REFERENCE",
    "bindings": [
      {
        "endpoint": "http://artifact.internal:8801/artifact/mcp",
        "workspace": "vv-services",
        "sandbox": "artifact",
        "port": 8801
      },
      {
        "endpoint": "http://media.internal:8802/media/mcp",
        "workspace": "vv-services",
        "sandbox": "media",
        "port": 8802
      },
      {
        "endpoint": "http://embedding.internal:8803/embedding/mcp",
        "workspace": "vv-services",
        "sandbox": "embedding",
        "port": 8803
      },
      {
        "endpoint": "http://console.internal:8805/console/mcp",
        "workspace": "vv-services",
        "sandbox": "console",
        "port": 8805
      }
    ]
  },
  "execution": {
    "baseBranch": "main"
  },
  "factory": {
    "gateway": {
      "endpoint": "https://openshell.openshell.svc.cluster.local:8080",
      "certificateAuthority": "/run/openshell-supervisor-ca/material/ca.crt",
      "bearerEnvironment": "HUB_NATIVE_CONTROL_REFERENCE"
    },
    "workspace": "vv-factory",
    "policyFile": "@claim:factory-base@",
    "template": {
      "workspace": "installation",
      "name": "factory-v1"
    },
    "port": 8800,
    "hubIssuer": "https://veoveo.bioma.ai",
    "loreServer": "grpcs://lore.veoveo-system.svc.cluster.local:41337",
    "registrationProfile": "vv-factory-registration",
    "loreProfile": "vv-factory-lore",
    "imageBuilder": {
      "buildkit": "tcp://buildkitd.veoveo-system.svc.cluster.local:1234",
      "registry": "registry.veoveo-system.svc.cluster.local:5000"
    },
    "caps": {
      "instancesPerUser": 4,
      "enforce": false
    },
    "providers": [
      {
        "provider": "vv-factory-model",
        "repositories": [
          "b2fd9e7fb1eb508979d7bdd70fa8e4c8"
        ]
      }
    ]
  },
  "lore": {
    "deployments": [
      {
        "id": "primary",
        "resourceName": "lore",
        "audience": "https://veoveo.bioma.ai/resources/lore",
        "endpoint": "grpcs://lore.veoveo-system.svc.cluster.local:41337",
        "authorizationServer": "hub",
        "policyVersion": "reference-policy",
        "loginScopes": [
          "lore:login",
          "offline_access"
        ],
        "scopeTemplate": "lore-repo-{id}",
        "resourceIdTemplate": "urc-{id}",
        "tokenLifetimeSeconds": 300
      }
    ],
    "repositories": [],
    "assignments": []
  },
  "oauthClients": [
    {
      "id": "lore-computer",
      "authorizationServer": "hub",
      "defaultWorkContext": "reference-work",
      "invocationMode": "direct",
      "displayName": "Native Lore public client",
      "allowedResources": [
        "https://veoveo.bioma.ai/resources/lore"
      ],
      "grantTypes": [
        "device_authorization",
        "refresh_token",
        "token_exchange"
      ],
      "authMethods": [
        "none"
      ],
      "allowedScopes": [
        "lore:login",
        "offline_access"
      ]
    },
    {
      "id": "computer-browser",
      "authorizationServer": "hub",
      "defaultWorkContext": "reference-work",
      "invocationMode": "direct",
      "displayName": "Private Computer browser",
      "allowedResources": [
        "https://veoveo.bioma.ai/mcp/computer"
      ],
      "grantTypes": [
        "authorization_code_pkce",
        "refresh_token"
      ],
      "authMethods": [
        "none"
      ],
      "redirectUris": [
        "https://veoveo.bioma.ai/computer/callback"
      ],
      "allowedScopes": [
        "mcp"
      ]
    },
    {
      "id": "veoveo-hub-sdk-cli",
      "authorizationServer": "hub",
      "defaultWorkContext": "reference-work",
      "invocationMode": "direct",
      "displayName": "veoveo-hub-sdk-cli",
      "allowedResources": [
        "https://veoveo.bioma.ai/mcp/local"
      ],
      "grantTypes": [
        "authorization_code_pkce",
        "refresh_token"
      ],
      "authMethods": [
        "none"
      ],
      "redirectUris": [
        "http://127.0.0.1:3211/callback"
      ],
      "allowedScopes": [
        "mcp"
      ]
    }
  ],
  "oidcClients": [
    {
      "id": "entra",
      "identityProvider": "entra",
      "authorizationServer": "hub",
      "allowedResources": [
        "https://veoveo.bioma.ai/mcp/computer",
        "https://veoveo.bioma.ai/mcp/local",
        "https://veoveo.bioma.ai/resources/lore"
      ],
      "clientId": "853550a7-5fd4-421c-abd2-bea0216fa579",
      "redirectUri": "https://veoveo.bioma.ai/oauth/callback",
      "authMethod": "client_secret_post",
      "credentialSecret": "entra_client_secret",
      "scopes": [
        "openid",
        "profile"
      ]
    }
  ]
}
