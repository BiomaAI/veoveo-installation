{
  "$schema": "https://opencode.ai/config.json",
  "model": "veoveo/XiaomiMiMo/MiMo-V2.6-Pro",
  "default_agent": "build",
  "update": "disable",
  "snapshots": false,
  "share": "disabled",
  "warming": false,
  "instructions": [
    "/etc/opencode/instructions.txt"
  ],
  "providers": {
    "veoveo": {
      "name": "Veoveo inference",
      "env": [
        "VEOVEO_INFERENCE_TOKEN"
      ],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.deepinfra.com/v1/openai",
        "timeout": 300000
      },
      "models": {
        "XiaomiMiMo/MiMo-V2.6-Pro": {
          "name": "MiMo V2.6 Pro",
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 196608,
            "output": 512
          },
          "compatibility": {
            "reasoningField": "reasoning_content"
          }
        }
      },
      "body": {
        "max_tokens": 512,
        "reasoning_effort": "none"
      }
    }
  },
  "policies": [
    {
      "action": "provider.use",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "provider.use",
      "resource": "veoveo",
      "effect": "allow"
    },
    {
      "action": "integration.use",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "subagent",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "agents": {
    "build": {
      "steps": 2
    },
    "smoke": {
      "mode": "primary",
      "steps": 2,
      "system": "Run only the user-requested local CLI command using shell. Report the result briefly. Do not inspect files, edit code, or invoke other agents."
    },
    "prepared-time": {
      "mode": "primary",
      "steps": 4,
      "system": "Execute only the supplied immutable Lore clone and exact Cargo release build using shell. Use the supplied shell timeout. Report revision, command, exit status and binary path. On any failure stop and report it. Do not edit source, repair the environment, change dependencies, retry, explore MCP, or invoke other agents."
    }
  },
  "tool_output": {
    "max_lines": 160,
    "max_bytes": 10000
  }
}
