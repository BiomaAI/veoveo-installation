{
  "docker": {
    "mounts": [
      {
        "type": "volume",
        "source": "vv-media-state",
        "target": "/var/lib/veoveo/media",
        "read_only": false
      },
      {
        "type": "volume",
        "source": "vv-media-config",
        "target": "/etc/veoveo/media",
        "read_only": true
      }
    ]
  }
}
