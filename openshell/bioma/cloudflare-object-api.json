{
  "name": "Bioma Veoveo API configuration",
  "kind": "zone",
  "phase": "http_config_settings",
  "rules": [
    {
      "ref": "veoveo_objects_api_no_bic",
      "description": "Allow non-browser signed S3 transfers; retain origin signature validation.",
      "expression": "http.host eq \"veoveo-objects.bioma.ai\"",
      "action": "set_config",
      "action_parameters": {
        "bic": false
      },
      "enabled": true
    }
  ]
}
