{
  "config": {
    "ingress": [
      {
        "hostname": "veoveo.bioma.ai",
        "path": "^/media/operations/[^/]+/[^/]+$",
        "service": "https://openshell.openshell.svc.cluster.local:8080",
        "originRequest": {
          "httpHostHeader": "vv-services--media--http.openshell.localhost",
          "originServerName": "openshell.openshell.svc.cluster.local",
          "caPool": "/etc/cloudflared-ca/gateway.crt"
        }
      },
      {
        "hostname": "veoveo.bioma.ai",
        "service": "https://openshell.openshell.svc.cluster.local:8080",
        "originRequest": {
          "httpHostHeader": "vv-control--hub--http.openshell.localhost",
          "originServerName": "openshell.openshell.svc.cluster.local",
          "caPool": "/etc/cloudflared-ca/gateway.crt"
        }
      },
      {
        "hostname": "veoveo-objects.bioma.ai",
        "service": "https://seaweedfs-s3.veoveo-system.svc.cluster.local:9000",
        "originRequest": {
          "originServerName": "seaweedfs-s3.veoveo-system.svc.cluster.local",
          "caPool": "/etc/cloudflared-ca/storage.crt"
        }
      },
      {
        "service": "http_status:404"
      }
    ]
  }
}
