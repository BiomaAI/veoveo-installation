#!/usr/bin/env python3
"""Provision one short-lived, read-only Lore credential for the first local factory."""
import argparse
import base64
import json
import os
from pathlib import Path
import re
import ssl
import subprocess
import tempfile
import time
import urllib.request
import uuid

ROOT = Path(__file__).resolve().parent.parent


def main():
    args = argparse.ArgumentParser(description=__doc__)
    args.add_argument("--repository", required=True)
    options = args.parse_args()
    os.umask(0o077)
    config = json.loads((ROOT / "state/desktop/identity/config.json").read_text())
    if not re.fullmatch(r"[0-9a-f]{32}", options.repository) or options.repository not in config["repositories"]:
        raise ValueError("repository must be explicitly configured in this installation")
    context = ssl.create_default_context(cafile=ROOT / "tls/desktop/localhost.crt")
    with urllib.request.urlopen("https://localhost:7443/oauth/jwks.json", context=context, timeout=10) as response:
        keys = json.loads(response.read())["keys"]
    if len(keys) != 1:
        raise ValueError("expected exactly the current Lore adapter signer")
    now = int(time.time())
    header = {"alg": "RS256", "typ": "at+jwt", "kid": keys[0]["kid"]}
    claims = {"iss": config["publicOrigin"] + "/oauth", "aud": [config["resource"]],
              "sub": "veoveo-first-factory", "client_id": "veoveo-first-factory", "iat": now, "nbf": now,
              "exp": now + 900, "jti": str(uuid.uuid4()),
              "resources": [{"resource_id": "urc-" + options.repository, "permission": ["read"]}]}
    encode = lambda value: base64.urlsafe_b64encode(value).decode().rstrip("=")
    message = ".".join(encode(json.dumps(value, separators=(",", ":")).encode()) for value in (header, claims))
    key = subprocess.run(["docker", "run", "--rm", "--network", "none", "--user", "root",
        "--cap-drop", "ALL", "--cap-add", "DAC_OVERRIDE", "--security-opt", "no-new-privileges",
        "-v", "vv-local_vv-lore-identity-secrets:/secrets:ro", "--entrypoint", "cat",
        "vv-lore:local", "/secrets/signing.key"], check=True, capture_output=True).stdout
    with tempfile.NamedTemporaryFile(dir=ROOT / "state/openshell") as temporary:
        temporary.write(key)
        temporary.flush()
        signature = subprocess.run(["openssl", "dgst", "-sha256", "-sign", temporary.name],
            input=message.encode(), check=True, capture_output=True).stdout
    target = ROOT / "state/openshell/lore.token"
    target.write_text(message + "." + encode(signature) + "\n")
    target.chmod(0o600)
    (target.parent / "lore-grant.json").write_text(json.dumps({"repository": options.repository,
        "expiresAt": now + 900, "permission": ["read"]}, indent=2) + "\n")
    print("Provisioned one repository-scoped read credential, valid for 15 minutes; token was not printed")


if __name__ == "__main__":
    try:
        main()
    except Exception as error:
        raise SystemExit(f"Lore credential provisioning failed ({type(error).__name__}); secrets were not printed") from None
